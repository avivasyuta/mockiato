{
    "name": "mockiato",
    "private": true,
    "type": "module",
    "dependencies": {
        "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
        "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.2.0",
        "@atlaskit/pragmatic-drag-and-drop-react-drop-indicator": "^4.2.0",
        "@mantine/core": "^9.6.0",
        "@mantine/form": "^9.6.0",
        "@mantine/hooks": "^9.6.0",
        "@mantine/modals": "^9.6.0",
        "@mantine/next": "^6.0.22",
        "@mantine/notifications": "^9.6.0",
        "@mantine/utils": "^6.0.22",
        "@mswjs/interceptors": "0.25.2",
        "@playwright/test": "^1.62.1",
        "@tabler/icons-react": "^3.46.0",
        "@vitejs/plugin-react": "^6.1.1",
        "classnames": "^2.5.1",
        "jsoneditor": "^10.4.3",
        "nanoid": "^6.0.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "vite": "^8.2.2",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^5.0.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@types/chrome": "^0.2.8",
        "@types/jsoneditor": "^9.9.6",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@eslint/js": "^9.39.5",
        "@vitest/coverage-v8": "^5.0.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "lint-staged": "^17.4.1",
        "prettier": "^3.9.6",
        "stylelint": "^17.14.1",
        "stylelint-config-standard": "^40.0.0",
        "typescript-eslint": "^8.69.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "typescript": "^6.0.3"
    },
    "scripts": {
        "dev": "VITE_NODE_ENV=development vite",
        "build": "VITE_NODE_ENV=production npm run build:ext && npm run build:content && npm run build:mockiato && npm run build:devtools && npm run build:popup",
        "build:ext": "vite build",
        "build:content": "vite build --config config/vite.config.content.ts",
        "build:mockiato": "vite build --config config/vite.config.mockiato.ts",
        "build:devtools": "vite build --config config/vite.config.devtools.ts",
        "build:popup": "vite build --config config/vite.config.popup.ts",
        "lint": "npm run lint:ts && npm run lint:css",
        "lint:ts": "eslint .",
        "lint:css": "stylelint src/**/*.css",
        "typecheck": "npx tsc --noEmit --project ./tsconfig.json",
        "test": "vitest run src",
        "test:coverage": "vitest run src --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    }
}
